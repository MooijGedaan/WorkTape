{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "worktape",
  "version": "0.1.0",
  "identifier": "com.worktape.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkTape",
        "width": 1200,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700,
        "visible": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://worktape-proxy.daanmooij-385.workers.dev https://api.github.com https://github.com;"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://worktape-proxy.daanmooij-385.workers.dev/v1/update/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzRjI3OEQ4RURFREE4REMKUldUY3FPM3QySGp5QTR3RmxraTluR3F3UFU2aVVVTFBRd2o3UFlYMWlRL1IwVkROWS9lNjhGK2QK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
